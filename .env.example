# AI Provider — use ONE (Groq is free, no credit card)
# Groq: groq.com → console → API Keys → Create
GROQ_API_KEY=

# Anthropic (optional fallback)
ANTHROPIC_API_KEY=

# Sendblue (iMessage API) — get at sendblue.com
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=

# Path to the crypto wallet/data CLI this app shells out to (defaults to 'mp' on PATH)
# NOTE: 'mp' is a real third-party financial CLI (MoonPay's agent CLI) — swap
# MP_PATH / src/services/nova.ts for your own crypto data + wallet provider in a public fork.
MP_PATH=mp

# Server
PORT=3000

# SQLite DB path
DB_PATH=./data/poke.db

# Public URL for webhook (use localtunnel or ngrok in dev)
# e.g. https://crypto-poke.loca.lt
WEBHOOK_BASE_URL=
